# Copy to /etc/systemd/system/gogame@.service.
# Adjust User, Group, node executable, WorkingDirectory and EnvironmentFile.
[Unit]
Description=Gogame %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gogame
Group=gogame
WorkingDirectory=/opt/gogame/app
Environment=NODE_ENV=production
Environment=GOGAME_ENV=prod
Environment=IS_DEV=0
EnvironmentFile=/etc/gogame/runtime.env
ExecStart=/usr/bin/node scripts/prod.js %i
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
