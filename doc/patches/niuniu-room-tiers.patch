+package gogame
+
+import (
+	"fmt"
+
+	"gorm.io/gorm"
+)
+
+// Ordinary table 牛牛; lobby 20 maps to room 24. Hundred-player 牛牛 is separate.
+func seedNiuniuIfMissing(m *gorm.DB, now int64) {
+	tiers := [][6]int64{
+		{71, 3, 20, 3, 2, 2000}, {2410, 7, 30, 4, 2, 20000},
+		{19, 3, 10, 4, 2, 1000}, {69, 3, 50, 4, 4, 5000},
+		{2406, 0, 10, 0, 2, 1000}, {2401, 3, 200, 3, 4, 50000},
+		{2402, 7, 1, 4, 2, 500}, {2403, 7, 50, 4, 2, 50000},
+		{126, 3, 200, 4, 4, 50000}, {131, 7, 10, 4, 2, 5000},
+		{2411, 3, 100, 4, 4, 20000}, {72, 3, 50, 3, 4, 10000},
+		{2408, 0, 50, 0, 2, 5000}, {2412, 3, 1, 3, 4, 100},
+	}
+	for index, tier := range tiers {
+		id, mode, ante, see, class, carry := tier[0], tier[1], tier[2], tier[3], tier[4], tier[5]
+		var count int64
+		if err := m.Model(&RoomConfig{}).Where("room_type = ? AND game_room_config_id = ?", 24, id).Count(&count).Error; err != nil {
+			continue
+		}
+		if count != 0 {
+			continue // Existing operator settings always take priority.
+		}
+		payload := mustJSON(map[string]any{
+			"roomType": 24, "gameRoomConfigId": id, "playMode": mode,
+			"ante": ante, "initialBet": ante, "seeCardNo": see,
+			"carryMin": carry, "roomClassification": class, "maxPeople": 7,
+			"smallBlind": 0, "bigBlind": 0, "roomIndex": 0, "totalPeople": 0,
+			"forceShowCard": false,
+			"key": fmt.Sprintf("24/%d/%d/%d/%d/%d", mode, ante, see, class, carry),
+		})
+		name := fmt.Sprintf("看%d张牛牛", see)
+		if mode == 0 {
+			name = "全暗牛牛"
+		} else if mode == 7 {
+			name = "七癞牛牛"
+		}
+		m.Create(&RoomConfig{
+			GameType: 20, SubGameType: 0, RoomType: 24, GameRoomConfigId: id,
+			PlayMode: int32(mode), CarryMin: carry, Category: RoomCategoryNormal,
+			Name: fmt.Sprintf("%s 底注%d", name, ante), Payload: payload,
+			State: 1, SortIndex: int32(2400 + index), CreateTime: now, UpdateTime: now,
+		})
+	}
+}
