+		name            string
+	}{
+		{2501, 10, 100, 3, 2, "炸金花 底注10"},
+		{16, 100, 1000, 3, 2, "炸金花 底注100"},
+		{17, 500, 5000, 3, 4, "炸金花 底注500"},
+		{125, 2000, 50000, 3, 4, "炸金花 底注2000"},
+		{134, 100, 1000, 2, 2, "看二张 底注100"},
+		{73, 500, 5000, 2, 2, "看二张 底注500"},
+		{74, 2000, 50000, 2, 4, "看二张 底注2000"},
+		{2503, 10, 100, 5, 2, "看一张 底注10"},
+		{2502, 100, 1000, 5, 2, "看一张 底注100"},
+	}
+	rooms := make([]*RoomConfig, 0, len(tiers))
+	for index, tier := range tiers {
+		room := zjhRoom(now, tier.id, tier.ante, tier.carry, tier.mode, tier.class, tier.name)
+		room.SortIndex = int32(2500 + index)
+		rooms = append(rooms, room)
+	}
+	return rooms
 }
 
